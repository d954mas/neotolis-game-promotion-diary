# nginx template. nginx terminates HTTPS on the VPS using a Cloudflare
# Origin CA cert; Cloudflare also terminates TLS at the edge and connects
# to origin over HTTPS (Full Strict mode — see docs/deploy/install.md §2
# step 4 for cert generation). The application's `proxy-trust.ts`
# middleware reads CF-Connecting-IP for client-IP rewrite — nginx ALSO
# rewrites $remote_addr via real_ip_header below; both layers are correct
# (defense-in-depth) and the application's middleware is idempotent under
# repeated rewrites.
#
# nginx listens ONLY on 443. Origin never participates in plaintext HTTP —
# UFW closes port 80 (install.md §1 Step 2), docker-compose.prod.yml does
# NOT publish port 80, and CF "Always Use HTTPS" rule (install.md §2
# Step 4.4) bounces user-typed `http://` at the edge before any request
# could reach origin. This is the strict reading of the constraint
# "TLS 1.3 + HSTS, plain HTTP only behind a TLS-terminating proxy".
# TLS 1.3 only.
#
# `${DOMAIN}` is substituted by nginx's envsubst-on-startup behavior when
# this file is mounted at /etc/nginx/templates/default.conf.template (the
# nginx:alpine image scans /etc/nginx/templates/* and emits expanded copies
# into /etc/nginx/conf.d/). The container's DOMAIN env var feeds the swap.

# Cloudflare's "real client IP" — must precede the first set_real_ip_from
real_ip_header CF-Connecting-IP;
real_ip_recursive on;

# Cloudflare published IP ranges (sourced from cf-ips.conf — refreshed
# quarterly per docs/deploy/install.md §"Refresh CF IPs").
include /etc/nginx/cf-ips.conf;

# Per-IP rate limit on auth endpoints (10 req/sec per IP).
# 10 req/sec, burst 20, no-delay (immediate 503 on burst overrun).
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/s;

# Structured JSON access log so Promtail/Loki parse nginx requests into the
# same shape as the app's Pino logs (queryable by status, method, path).
# escape=json keeps the line valid JSON even when a field contains quotes.
# `level:"info"` is a synthetic field so the access stream sorts cleanly
# alongside Pino level semantics; nginx ERROR diagnostics still go to
# error_log as plain text (open-source nginx cannot emit JSON error_log) —
# those are caught by the Grafana catch-all regex panel instead.
#
# PRIVACY (load-bearing — these logs ship to Loki, bypassing Pino redaction):
#   - `$uri` (path only) NOT `$request_uri` — the query string carries OAuth
#     `code`/`state` on the callback and private feed-filter state; logging it
#     would leak secrets to Loki. `$uri` answers "which route" without the query.
#   - `$http_referer` is OMITTED — it can carry full external URLs with their
#     own sensitive query params.
#   - `user_agent` is OMITTED (opsec: the app redacts UA too).
# The nginx-access-log privacy invariant is locked by tests/unit/nginx-access-log.test.ts.
log_format json_access escape=json
  '{'
    '"time":"$time_iso8601",'
    '"level":"info",'
    '"source":"nginx",'
    '"remote_addr":"$remote_addr",'
    '"method":"$request_method",'
    '"path":"$uri",'
    '"status":"$status",'
    '"body_bytes":"$body_bytes_sent",'
    '"request_time":"$request_time",'
    '"upstream_time":"$upstream_response_time",'
    '"host":"$host"'
  '}';

# Hide nginx version from response headers
server_tokens off;

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    # Cloudflare Origin CA cert (15-year validity, valid only inside CF's
    # network — pairs with CF SSL/TLS mode "Full (Strict)"). Generated in
    # CF dashboard → SSL/TLS → Origin Server (see install.md §2 step 7).
    # Mounted from ./nginx/certs on the VPS via docker-compose.prod.yml.
    ssl_certificate /etc/nginx/certs/origin.pem;
    ssl_certificate_key /etc/nginx/certs/origin.key;
    ssl_protocols TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # JSON access log to stdout (Promtail collects container stdout/stderr).
    access_log /dev/stdout json_access;

    # Resolver for Docker network DNS (app:3000)
    resolver 127.0.0.11 valid=10s ipv6=off;

    # gzip on for HTML / JSON / CSS / JS responses (D-Discretion item)
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/rss+xml;
    gzip_min_length 1024;

    # Security headers (CF also sets HSTS at the edge; defense-in-depth here too)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Rate-limited auth endpoints (Better Auth + OAuth callback)
    location /api/auth/ {
        limit_req zone=auth burst=20 nodelay;
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Forward CF-Connecting-IP through (real_ip_header above already
        # rewrote $remote_addr; the application's proxy-trust middleware
        # also reads CF-Connecting-IP — both are correct, double-checked).
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # Block /metrics from external access -- Prometheus scrapes via Docker
    # internal network (D-03). Return 404 (not 403 -- AGENTS.md invariant).
    location = /metrics {
        return 404;
    }

    # Grafana dashboard UI (Phase 7 observability). Variable forces
    # runtime DNS resolution — nginx boots even without the monitoring
    # overlay. Grafana runs with SERVE_FROM_SUB_PATH=true and expects
    # requests at /grafana/*; the variable-based proxy_pass preserves
    # the full URI (no prefix stripping), which is what we want.
    location /grafana/ {
        set $grafana http://grafana:3000;
        proxy_pass $grafana;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
    }

    # Everything else
    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_cache_bypass $http_upgrade;
        # 60s read timeout matches the export-account streaming response
        # for heavy users (~10MB envelope; comfortable margin).
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_connect_timeout 10s;
    }
}
