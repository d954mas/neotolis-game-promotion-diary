# Phase 1 Foundation environment variables
# Copy to .env for local dev; never commit .env
#
# For production deployment of every var below: see docs/deploy/install.md
# § references throughout this file map to the runbook section that
# explains where to obtain / how to generate that var's value.

# Required
#
# Production Postgres password (D-03). Generated on first deploy via
# `openssl rand -base64 32`; consumed by docker-compose.prod.yml's
# postgres service. See install.md §4 step 3.
# Leave empty for local dev (DATABASE_URL below uses the postgres/postgres
# default). Defined FIRST in this file so any later line that interpolates
# ${POSTGRES_PASSWORD} resolves correctly (Compose interpolates .env
# top-down — forward references break with empty substitution).
POSTGRES_PASSWORD=

# DATABASE_URL: only used by `pnpm dev` (local development, single-process
# Postgres on localhost). docker-compose.prod.yml builds its own DATABASE_URL
# in each service's `environment:` block — on prod you can leave this line
# as-is (compose's env block wins) or delete it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/neotolis
BETTER_AUTH_URL=http://localhost:3000
# See install.md §4 step 4 for value-generation procedure (openssl rand -base64 48)
BETTER_AUTH_SECRET=replace-with-32-char-random-hex-or-longer-please
# See install.md §3 (Google Cloud Console) for OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET
OAUTH_CLIENT_ID=your-google-oauth-client-id
OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# See install.md §4 step 4 for value-generation procedure (openssl rand -base64 32)
APP_KEK_BASE64=base64-encoded-32-bytes-here  # generate with: openssl rand -base64 32

# OAuth identity provider (advanced — self-host only)
#
# By default the app authenticates against Google. SaaS NEVER overrides
# any of these. A self-host operator MAY point at any OIDC-compatible
# IdP (Keycloak, Authentik, Auth0, ...) at their own risk — this is
# unsupported / advanced: the app's UX, message strings, and audit
# semantics assume Google, and switching IdPs after rows already exist
# requires manual data migration.
#
# OAUTH_PROVIDER_ID is written to `account.providerId`. If you change
# OAUTH_DISCOVERY_URL to a non-Google IdP you MUST also change
# OAUTH_PROVIDER_ID — otherwise rows are mislabelled.
# OAUTH_PROVIDER_ID=google
# OAUTH_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration

# Override Better Auth's secure-cookie default. Defaults to NODE_ENV ===
# "production". Set to "false" if you run the production image behind a
# TLS-terminating reverse proxy that speaks plain HTTP to the app container —
# otherwise Better Auth emits the `__Secure-` cookie prefix and browsers
# refuse to set it over HTTP. Leave unset on real direct-TLS deployments.
# BETTER_AUTH_SECURE_COOKIES=false

# Optional (defaults shown)
#
# IMPORTANT: do NOT put inline comments after `VAR=value`. docker-compose's
# env_file directive sometimes treats the entire trailing text as part of
# the value, even when separated by whitespace. The classic trap:
#   COOKIE_DOMAIN=                  # optional; needed only for SaaS ...
# becomes a Set-Cookie with `Domain=# optional...` — browser silently
# rejects the cookie, OAuth state cookie is lost, login fails with
# `state_mismatch` (issue #14). Always put comments on lines BEFORE the
# variable, never after `=`.

# NODE_ENV: 'development' for `pnpm dev` (loads pino-pretty for human-readable
# logs). Production deployments MUST set 'production' — otherwise the app
# tries to load pino-pretty which is not in the production image and the
# container crash-loops with `unable to determine transport target for
# "pino-pretty"`. docker-compose.prod.yml hard-pins this to 'production' in
# the `environment:` block so operator-side .env mistakes don't surface.
NODE_ENV=development

# APP_ROLE: which role this container runs. One of: app | worker | scheduler.
APP_ROLE=app

# APP_MODE: deployment shape. One of: saas | selfhost.
APP_MODE=selfhost

PORT=3000

# LOG_LEVEL: one of: debug | info | warn | error.
LOG_LEVEL=info

# TRUSTED_ORIGINS: CSV of allowed CORS origins.
TRUSTED_ORIGINS=

# TRUSTED_PROXY_CIDR: CSV of trusted proxy CIDRs (D-20: empty = trust nothing).
# See install.md §4 step 4 — paste contents of nginx/cf-ips.conf
# (CIDRs only, comma-separated; refresh quarterly per install.md §5).
TRUSTED_PROXY_CIDR=

# COOKIE_DOMAIN: optional; only set for SaaS subdomain cookies (e.g. Better
# Auth's crossSubDomainCookies feature). Leave EMPTY otherwise. Never put a
# comment after `=` here — docker-compose env_file may include the comment
# text as the cookie's Domain attribute (issue #14). If you don't need
# subdomain cookies, the line below MUST be exactly `COOKIE_DOMAIN=` with
# nothing after the `=`.
COOKIE_DOMAIN=

KEK_CURRENT_VERSION=1

# APP_KEK_V2_BASE64=... (add during KEK rotation; remove APP_KEK_BASE64
# only after re-wrap)

# Phase 2 — soft-delete retention window (days). Default: 60.
# The Phase 3 purge worker hard-deletes rows where deleted_at < now() - RETENTION_DAYS::interval.
# Self-host operators may set their own value; SaaS uses the default.
RETENTION_DAYS=60

# ---- Phase 02.2: open-signup public-SaaS surface ----

# Support contact email shown on /privacy, /terms, /about, footer. Self-host
# operators MUST configure this for GDPR compliance — data-subject requests
# must reach a real human. SaaS prod sets it to the author's project email.
# See install.md §3 (the same email is the OAuth Console "support email").
SUPPORT_EMAIL=

# Per-user abuse limits (D-11). Defaults are indie-friendly; self-host
# operators may raise them. SaaS prod uses defaults.
LIMIT_GAMES_PER_USER=50
LIMIT_SOURCES_PER_USER=50
LIMIT_EVENTS_PER_DAY=500
# Per-user cap on cache-miss YouTube metadata fetches ("Get from YouTube"
# button). Cache hits don't count. Default 50/day.
LIMIT_YOUTUBE_METADATA_FETCHES_PER_DAY=50

# Image tag override for docker-compose.prod.yml. Default 'latest';
# rollback sets to a specific git sha (D-24).
# See install.md §5 (Rollback) — `pnpm deploy:rollback <sha>` sed-edits
# this var on the VPS.
IMAGE_TAG=latest

# Production domain (D-04 / D-07). Self-host operators set to their domain.
# See install.md §2 (Domain + Cloudflare setup) for registration + DNS.
DOMAIN=

# ---- Phase 3.0 — polling-pipeline plumbing (YouTube) ----

# Comma-separated operator-owned YouTube Data API v3 keys (D-06).
# Empty default ⇒ auto-import + scheduled polling are DISABLED (smoke +
# self-host parity preserved by construction). Each key gets ~10k units/day
# from Google; the worker rotates across the set when the per-key ceiling
# is approached. Stored plaintext in env (operator's own keys, NOT user
# secrets — pino redact paths cover the field name `apiKey`).
SERVICE_YOUTUBE_API_KEYS=

# Comma-separated admin user emails (case-insensitive). Empty default ⇒
# /admin/* returns 404 for everyone (self-host parity — D-16). Changes
# require a container restart (parsed once at boot).
ADMIN_EMAIL_ALLOWLIST=

# YouTube Data API v3 base URL. Production default = the official endpoint
# (do NOT change in production). The CI smoke gate overrides this to a
# mock reverse-proxy URL for hermetic testing.
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# ---- Phase 03.1 — Reddit adapter (DV-RDT-7: public-.json) ----

# Reddit operator User-Agent (Phase 03.1, DV-RDT-7: public-.json adapter).
# Empty default disables Reddit cleanly (self-host parity preserved by
# construction — boot succeeds, /sources renders "Reddit not configured",
# paste returns 422 reddit_not_configured, smoke gate validates V3+V24).
# When configured, MUST match `<platform>:<id>:<version> (by /u/<handle>)`
# per Reddit ToS. Default UAs (urllib, axios, node-fetch) are aggressively
# rate-limited. Reddit Responsible Builder Policy (Nov 2025) closed
# self-service OAuth registration; public `.json` endpoints work without
# app pre-approval but have a 10 req/min hard limit (adapter uses 8 req/min
# effective ceiling).
#
# Convention — distinguish environments via the <version> slot (regex
# allows `.` and `-` here). Reddit's traffic-team can then tell dev/staging
# probes from real production load if they reach out about UA-level
# behavior:
#   production : node:com.neotolis.gpd:0.1.0      (by /u/<handle>)
#   staging    : node:com.neotolis.gpd:0.1.0-rc.1 (by /u/<handle>)
#   local dev  : node:com.neotolis.gpd:0.1.0-dev  (by /u/<handle>)
# Keep <id> stable across envs — that's the app identity. The handle MUST
# be a real Reddit account so Reddit can contact the operator if needed.
#
# Example value (local-dev shape):
#REDDIT_USER_AGENT=node:com.neotolis.gpd:0.1.0-dev (by /u/your-reddit-handle)
REDDIT_USER_AGENT=

# Reddit API base URL override — TEST-ONLY. Production default = the
# official endpoint (https://www.reddit.com — do NOT set in production).
# The CI smoke gate sets this to a mock reverse-proxy URL
# (tests/smoke/lib/reddit-mock.mjs) so worker traffic is intercepted in
# CI. Leave unset on real deployments. Validated as URL so typos fail
# fast at boot.
#REDDIT_BASE_URL_OVERRIDE=http://localhost:18080

# Optional outbound HTTP proxy for Reddit fetches. When set, every
# redditFetch routes through this proxy via undici's ProxyAgent.
# Empty/unset = direct fetch (the right choice for self-host operators
# on residential IPs — Reddit doesn't fence consumer ISPs).
#
# When to set: your deployment lives on a cloud VPS (Hetzner, DO,
# Linode, AWS, etc.). Reddit aggressively 403's every datacenter IP
# range. A residential proxy makes Reddit see a consumer-ISP IP and
# respond normally. Tested working: Webshare static-residential
# ($6/mo, 20 IPs, 250GB bandwidth). Other residential providers
# (Bright Data, Smartproxy, Decodo) should work the same shape.
#
# Format: http://user:pass@host:port  (Webshare emits this shape).
# Diagnose your VPS first — if a direct curl to /r/X/new.json returns
# 200, you don't need a proxy. See docs/deploy/MANUAL-DEPLOY.md
# "Reddit + cloud-hosted VPS reality check" for the curl one-liner.
#REDDIT_PROXY_URL=http://user:pass@host:port

# Worker container replica count hint for operators (default 1).
# Adapter-owned workers are protected by per-adapter singleton locks or
# DB-backed claim gates, so this is a deployment hint, not a quota guard.
WORKER_REPLICA_COUNT=1

# ---- Phase 8 — Social provider port + Instagram + cost guardrails ----

# Which provider implementation serves the `instagram` platform. Only
# `scrapecreators` is implemented today. Empty default ⇒ Instagram is NOT
# configured: the add-source IG chip renders disabled (SOC-05 graceful
# degrade), no scraper credits are ever spent, and boot still succeeds
# (self-host parity — "not configured" is the empty-env state, not a mode).
#INSTAGRAM_PROVIDER=scrapecreators
INSTAGRAM_PROVIDER=

# Operator's prepaid ScrapeCreators API key (the x-api-key header). Plaintext
# env, NOT envelope-encrypted (CONTEXT D-03 revised): operator config like
# SERVICE_YOUTUBE_API_KEYS, never a per-user DB secret. Empty ⇒ provider not
# configured. Pino redact path `apiKey` covers the field name; the key is
# scrubbed from process.env after parse. Get a key + 100 free credits at
# https://scrapecreators.com (pay-as-you-go, ~$0.002/request).
SCRAPECREATORS_API_KEY=

# ScrapeCreators API base URL. Production default = the official endpoint
# (do NOT change in production). The smoke gate / provider-mock overrides
# this to a local reverse-proxy URL (mirrors YOUTUBE_API_BASE_URL).
SCRAPECREATORS_BASE_URL=https://api.scrapecreators.com

# Per-user fair-share cap on social-provider requests (QUOTA-03). ≈ $0.10/day
# at 50. The per-user pool funds only user-initiated work (initial backfill,
# manual refresh, history expansion); ongoing polling is operator-funded.
# Exceed ⇒ 429 via the existing graceful per-user-quota path.
LIMIT_SOCIAL_REQUESTS_PER_DAY=50

# Backfill post-count cap — the cost-meaningful internal ceiling (default 48
# = 4 pages of 12). The walker stops at this OR the date window below,
# whichever first, so cost is independent of archive size (BACK-01).
SOCIAL_BACKFILL_MAX_POSTS=48

# Default backfill date window in days. The user may self-expand to any
# window (incl. "everything") via the BackfillPicker / backfill_target_since
# flow; this is the default boundary on add.
SOCIAL_BACKFILL_WINDOW_DAYS=30

# Operator daily spend envelope in credits. Reuses the YouTube 80/95 throttle
# + midnight-Pacific daily reset: the daily cap RESETS each day. 0 default ⇒
# no spend allowed until set (safe default; moot while INSTAGRAM_PROVIDER is
# empty). Operators who budget monthly set daily = monthly / 30.
# JOINT across platforms (D-01): this one cap covers ALL ScrapeCreators
# platforms on a provider (Instagram + TikTok + …) combined, because they draw
# from one shared prepaid balance. The 80/95 throttle bands are computed on the
# COMBINED daily spend; per-platform spend stays visible via the platform labels
# in /admin/quota + Prometheus, but it does NOT get its own separate cap.
SOCIAL_PROVIDER_DAILY_CAP_CREDITS=0

# Operator's funded prepaid balance in credits — the ABSOLUTE hard ceiling,
# shared across all platforms on a provider (D-01). Unlike the daily cap, this
# does NOT reset daily: it is monotonically decremented as credits are spent.
# The quota_reset cron clears only the daily-cap counter, never this balance.
# 0 default ⇒ degrade.
SOCIAL_PROVIDER_PREPAID_BALANCE_CREDITS=0

# Concurrency of the social-provider per-post Refresh lane. The single-post
# endpoint can't batch (1 request = 1 post), so the lane worker claims up to N
# rows per tick and fetches them CONCURRENTLY — this is the parallelism knob, not
# a batch-in-one-request size. Keep conservative for provider rate limits.
SOCIAL_REFRESH_LANE_CONCURRENCY=10

# Warm auto-refresh window (#69 follow-on). A post is auto-refreshed ~1×/day for
# its first N days of life (free while on page-1 of the account feed; paid via the
# single-post lane once it rolls off), then frozen (manual Refresh only). Bounds
# spend to ≤ N credits/post — the first week is the wishlist-correlation window.
INSTAGRAM_WARM_WINDOW_DAYS=7
# Staleness gate (hours): a warm post is re-refreshed only when not polled within
# this window. Must be JUST OVER the 24h free account-poll interval — the daily
# account poll re-stamps last_polled_at on every page-1 post, so >24h keeps page-1
# posts under the gate (free poll covers them, we never pay) and only off-page-1
# posts go stale enough to earn a paid refresh. <24h would pay for page-1 posts the
# free poll already covers. 26h = 24h + 2h jitter margin.
INSTAGRAM_WARM_STALENESS_HOURS=26
# Consecutive non-ok polls before a post drops out of warm auto-refresh. IG maps
# transient + budget-exhaustion to auth_error; this bounds a blip (self-heals) and
# a persistent failure (stops churning credits). Resets on the next ok poll.
INSTAGRAM_WARM_MAX_FAILURES=5

# --- Telegram (Phase 9, free t.me/s scrape — no secret) ---

# Warm per-post auto-refresh window (days). A post gets a free single-post
# ?embed=1 refresh via the service_post lane while younger than this AND stale.
TELEGRAM_WARM_WINDOW_DAYS=7
# Staleness gate (hours): a warm post is re-refreshed only when not polled within
# this window. 12h > the 6h listing-poll interval, so posts still on the listing
# (re-stamped every 6h) never enter the warm lane — only posts that scrolled off.
TELEGRAM_WARM_STALENESS_HOURS=12
# Consecutive non-ok polls before a post drops out of warm auto-refresh. Stops
# hammering a permanently-broken post; resets to 0 on the next ok poll.
TELEGRAM_WARM_MAX_FAILURES=5
# Backfill post-count cap — the dedicated ceiling the ?before walker stops at
# (free t.me/s scrape, so depth is paced not credit-bounded; deeper default than
# IG's SOCIAL_BACKFILL_MAX_POSTS). The walker stops at this OR the date window,
# whichever first, so cost/time is bounded regardless of archive size.
TELEGRAM_BACKFILL_MAX_POSTS=100

# --- TikTok (Phase 10, paid ScrapeCreators scraper — reuses IG's account) ---

# TikTok provider selection. Mirrors INSTAGRAM_PROVIDER. Set to `scrapecreators`
# to enable (uncomment the hint line). Empty (default) ⇒ TikTok is NOT
# configured: the add-source TikTok chip renders disabled (SOC-05 graceful
# degrade), no scraper credits are ever spent, and boot still succeeds (self-host
# parity — "not configured" is the empty-env state, not a mode). TikTok REUSES
# the existing SCRAPECREATORS_API_KEY + SCRAPECREATORS_BASE_URL + the SAME
# SOCIAL_PROVIDER_* / SOCIAL_BACKFILL_* budget envelope as Instagram — IG and
# TikTok draw from ONE shared prepaid balance per provider (D-01). NO new budget
# vars, NO new secret.
#TIKTOK_PROVIDER=scrapecreators
TIKTOK_PROVIDER=

# Warm auto-refresh (same shape + defaults as the Instagram warm lane). A post
# gets a PAID single-post refresh ~1×/day for its first N days, then frozen
# (manual Refresh only). Staleness stays just over the 24h free account-poll
# interval (TikTok is a paid scraper like IG) to avoid double-paying page-1 posts.
TIKTOK_WARM_WINDOW_DAYS=7
TIKTOK_WARM_STALENESS_HOURS=26
TIKTOK_WARM_MAX_FAILURES=5

# --- Twitter/X (Phase 11, paid twitterapi.io scraper — a SECOND vendor) ---

# Twitter/X provider selection. Empty (the default) => Twitter/X is NOT
# configured: the add-source Twitter chip renders disabled (SOC-05 graceful
# degrade), no scraper credits are ever spent, and boot still succeeds (self-host
# parity — "not configured" is the empty-env state, not a mode). UNLIKE TikTok,
# Twitter/X does NOT reuse the ScrapeCreators account: it uses a NEW second vendor
# twitterapi.io with its OWN TWITTERAPIIO_API_KEY (below) and its OWN per-provider
# prepaid balance row (D-02 — separate prepaid balance per provider; the
# per-provider social_provider_balance re-key from Plan 10-01 gives it one
# automatically; IG/TikTok spend does NOT draw it down). It REUSES the SAME
# SOCIAL_PROVIDER_* / SOCIAL_BACKFILL_* budget/cap envelope — NO new budget vars.
#TWITTER_PROVIDER=twitterapi.io
TWITTER_PROVIDER=

# twitterapi.io dashboard API key — a SEPARATE prepaid balance from ScrapeCreators.
# Fund a prepaid balance ($0.10 free credits cover the initial spike). The key
# rides only in the X-API-Key header and is never logged (Pino redact path
# covers the field name; scrubKekFromEnv strips it from process.env after parse).
TWITTERAPIIO_API_KEY=

# Warm auto-refresh (same shape + defaults as the Instagram / TikTok warm lane).
# A tweet gets a PAID single-tweet refresh ~1×/day for its first N days, then
# frozen (manual Refresh only). Staleness stays just over the 24h free
# account-poll interval (twitterapi.io is a paid scraper like IG/TikTok) to avoid
# double-paying page-1 tweets.
TWITTER_WARM_WINDOW_DAYS=7
TWITTER_WARM_STALENESS_HOURS=26
TWITTER_WARM_MAX_FAILURES=5

# ---- Phase 7 -- Observability (docker-compose.monitoring.yml) ----

# Bearer token protecting /metrics endpoint. Empty (default) = /metrics
# returns 404. Generate with: openssl rand -hex 32
# Write the SAME value to monitoring/prometheus/metrics-token (one line,
# no newline) so Prometheus can scrape.
#METRICS_BEARER_TOKEN=

# Grafana admin password. REQUIRED when running the monitoring overlay —
# compose will refuse to start without it. Generate a strong password.
#GF_SECURITY_ADMIN_PASSWORD=

# Grafana URL and path mode. Defaults work for selfhost bare-port
# (Grafana at http://host:3001/). For prod with nginx /grafana/ proxy:
#GF_SERVER_ROOT_URL=https://yourdomain.com/grafana/
#GF_SERVER_SERVE_FROM_SUB_PATH=true
# To disable external Grafana port (nginx-only access):
#GF_PORT=127.0.0.1:3001

# Webhook URL for Grafana alert notifications (D-08). Operator pastes
# any webhook URL (Discord webhook, Telegram bot adapter, custom
# endpoint). Empty = alerts silently disabled (silent degradation).
#ALERT_WEBHOOK_URL=

# Docker network name override. The monitoring overlay joins the main
# stack's Docker network. Default 'diary_default' matches the documented
# install path /opt/diary. Override if your directory name differs.
#COMPOSE_NETWORK=diary_default

# (POSTGRES_PASSWORD is defined at the top of this file — it must come
# before any line that interpolates ${POSTGRES_PASSWORD}. See top of file.)
