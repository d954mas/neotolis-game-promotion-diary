{
  "uid": "neotolis-logs",
  "title": "Neotolis Logs",
  "tags": ["neotolis"],
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "search",
        "type": "textbox",
        "label": "Search",
        "current": {
          "value": "",
          "text": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Error Logs (level >= 50)",
      "datasource": { "uid": "loki", "type": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "uid": "loki", "type": "loki" },
          "expr": "{service=~\"app|worker|scheduler\"} |= \"level\" | json | level >= 50",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Escaped Errors (catch-all — bypassed structured logging)",
      "description": "Safety net. Excludes all JSON lines (Pino + nginx access both carry \"level\":) and surfaces only plain-text error-shaped lines — raw Node crashes, framework stack traces, nginx error_log. If anything shows here, something logged outside Pino and should be routed through it.",
      "datasource": { "uid": "loki", "type": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "datasource": { "uid": "loki", "type": "loki" },
          "expr": "{service=~\"app|worker|scheduler|nginx\"} != `\"level\":` |~ `(?i)(uncaughtException|unhandledRejection|ERR_[A-Z0-9_]+|Error:|\\bFATAL\\b|\\bpanic\\b|\\[(error|crit|alert|emerg)\\])`",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Full-Text Search",
      "datasource": { "uid": "loki", "type": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 18 },
      "targets": [
        {
          "datasource": { "uid": "loki", "type": "loki" },
          "expr": "{service=~\".+\"} |= \"$search\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log Volume",
      "datasource": { "uid": "loki", "type": "loki" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "targets": [
        {
          "datasource": { "uid": "loki", "type": "loki" },
          "expr": "sum by (service) (count_over_time({service=~\".+\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
